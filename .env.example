# Wajib untuk pengiriman OTP. Gunakan salah satu format berikut.
# EMAIL_SERVER=smtps://username:app-password@smtp.example.com:465
EMAIL_SERVER=

# Prisma Postgres direct connection
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ganti-dengan-random-string-panjang-yang-aman"

# OAuth Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth Apple (opsional)
APPLE_ID=""
APPLE_SECRET=""

# Atau gunakan variabel terpisah:
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=VerapritygurlAI <no-reply@example.com>

# LLM API Key (Anthropic / OpenAI)
LLM_API_KEY=""
